import os
import sys
from datetime import datetime, timedelta
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.common.exceptions import TimeoutException, NoSuchElementException, WebDriverException

class MasQVidaAutomator:
    def __init__(self, config_file="config.txt"):
        self.config = self._load_configuration(config_file)
        if not self.config:
            print(f"Error: Configuration file '{config_file}' not found or empty.")
            sys.exit(1)

        self.user = self.config.get("USER")
        self.password = self.config.get("PASSWORD")
        self.url_acceso = "https://masqvidapaterna.deporsite.net/reserva-clases"
        self.horas_target = [h.strip() for h in self.config.get("HORAS", "").split(",") if h]
        self.filtros = [f.strip().upper() for f in self.config.get("FILTROS", "").split(",") if f]
        self.cuando = self.config.get("CUANDO", "hoy")
        self.palabra_busqueda = "Paterna"
        
        # Calculate target dates
        self.fecha_display, self.fecha_data = self._calcular_fechas(self.cuando)

    def _load_configuration(self, archivo):
        config = {}
        ruta_script = os.path.dirname(os.path.abspath(__file__))
        ruta_archivo = os.path.join(ruta_script, archivo)
        
        if not os.path.exists(ruta_archivo):
            return None
            
        with open(ruta_archivo, "r", encoding="utf-8") as f:
            for linea in f:
                linea = linea.strip()
                if "=" in linea and not linea.startswith("#"):
                    clave, valor = linea.split("=", 1)
                    config[clave.strip()] = valor.strip()
        return config

    def _calcular_fechas(self, opcion):
        hoy = datetime.now()
        if opcion.lower() == "mañana":
            target = hoy + timedelta(days=1)
        elif opcion.lower() == "pasado mañana":
            target = hoy + timedelta(days=2)
        else:
            target = hoy
        return target.strftime("%d/%m/%Y"), target.strftime("%Y-%m-%d")

    def _seleccionar_centro(self, driver, wait):
        try:
            btn_centro = wait.until(EC.element_to_be_clickable((By.CSS_SELECTOR, ".cambiar-centro-btn")))
            if self.palabra_busqueda.upper() in btn_centro.text.upper():
                return True
                
            driver.execute_script("arguments[0].click();", btn_centro)
            
            input_bus = wait.until(EC.visibility_of_element_located((By.XPATH, "//input[@placeholder='Encuentra Tu Centro']")))
            input_bus.clear()
            input_bus.send_keys(self.palabra_busqueda)
            
            xpath_res = f"//a[contains(translate(., 'abc', 'ABC'), '{self.palabra_busqueda.upper()}')]"
            resultado = wait.until(EC.element_to_be_clickable((By.XPATH, xpath_res)))
            resultado.click()
            
            # Wait for DOM to stabilize after center change
            wait.until(EC.presence_of_element_located((By.CLASS_NAME, "clase-selector")))
            return True
        except TimeoutException:
            print("Warning: Timed out while trying to select the center.")
            return False

    def ejecutar(self):
        logradas = 0
        options = webdriver.ChromeOptions()
        # options.add_argument('--headless') # Uncomment for background execution
        
        try:
            driver = webdriver.Chrome(options=options)
            wait = WebDriverWait(driver, 15)

            # 1. Authentication
            driver.get("https://masqvidapaterna.deporsite.net/loginmenu")
            wait.until(EC.presence_of_element_located((By.ID, "email"))).send_keys(self.user)
            driver.find_element(By.ID, "password").send_keys(self.password)
            driver.find_element(By.ID, "enviarFormulario").click()
            
            # Wait for successful login routing
            wait.until(EC.url_contains("reserva-clases"))
            driver.get(self.url_acceso)

            # 2. Iterative Booking
            for i, hora in enumerate(self.horas_target):
                self._seleccionar_centro(driver, wait)
                print(f"\n🔍 Processing session for {hora}...")
                
                try:
                    xpath_sesion = (
                        f"//div[contains(@class, 'clase-selector') and @data-idfecha='{self.fecha_data}']"
                        f"[.//div[@class='hora' and contains(text(), '{hora}')]]"
                    )
                    for f in self.filtros:
                        xpath_sesion += f"[contains(translate(., 'abc', 'ABC'), '{f}')]"

                    sesion = wait.until(EC.visibility_of_element_located((By.XPATH, xpath_sesion)))
                    driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", sesion)
                    driver.execute_script("arguments[0].click();", sesion)
                    
                    xpath_inscribirme = "//a[contains(@class, 'btn-reservar') and contains(., 'Inscribirme')]"
                    btn_inscribir = wait.until(EC.element_to_be_clickable((By.XPATH, xpath_inscribirme)))
                    driver.execute_script("arguments[0].click();", btn_inscribir)
                    
                    xpath_confirmar = "//div[contains(@class, 'btn-siguiente')][contains(., 'Reservar')]"
                    btn_final = wait.until(EC.element_to_be_clickable((By.XPATH, xpath_confirmar)))
                    
                    print("🚀 Confirming final reservation...")
                    driver.execute_script("arguments[0].click();", btn_final)
                    
                    wait.until(EC.url_contains("confirmacion")) # Wait for success page instead of sleep
                    print(f"✅ RESERVATION COMPLETED for {hora}!")
                    logradas += 1
                    
                    if i < len(self.horas_target) - 1:
                        driver.get(self.url_acceso)
                        wait.until(EC.presence_of_element_located((By.CLASS_NAME, "clase-selector")))
                        
                except TimeoutException:
                    print(f"❌ Failed to locate or reserve the class at {hora} (Timeout).")
                    driver.get(self.url_acceso)
                except WebDriverException as e:
                    print(f"❌ WebDriver Error processing {hora}: {str(e)}")
                    driver.get(self.url_acceso)

            return f"\n🏁 Process Finished: {logradas} reservation(s) successfully made."

        finally:
            driver.quit()

if __name__ == "__main__":
    bot = MasQVidaAutomator()
    print(bot.ejecutar())
